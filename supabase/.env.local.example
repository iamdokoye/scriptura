# Example local environment configuration for Supabase Edge Functions
# (`supabase functions serve --env-file supabase/.env.local`)
#
# DO NOT commit real secrets to source control.

# Required for Claude-powered scripture search (Ask Scripture):
ANTHROPIC_API_KEY=sk-ant-api03-...

# Models (default is claude-haiku-5-5 for both stages):
NOMINATE_MODEL=claude-haiku-5-5
VERIFY_MODEL=claude-haiku-5-5

# Rate limits & safety circuit breaker:
FREE_DAILY_LIMIT=50
GLOBAL_DAILY_LIMIT=3000

# Backend selection: "claude" (default) or "modal"
SEARCH_BACKEND=claude

# Optional Modal GPU service configuration (only used if SEARCH_BACKEND=modal):
# MODAL_URL=https://...modal.run
# MODAL_KEY=...
# MODAL_SECRET=...
